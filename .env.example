# Variables read by docker-compose.yml. Copy to `.env` (git-ignored) to override the dev defaults.
# These are development placeholders, never real production secrets.

MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=takeoff
MYSQL_USER=takeoff
MYSQL_PASSWORD=change_me_db_password
# Host port for MySQL (container port is always 3306).
MYSQL_PORT=3307

RABBITMQ_USER=takeoff
RABBITMQ_PASSWORD=change_me_rabbit_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
