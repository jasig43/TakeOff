# Environment variables read by the TakeOFF backend (see src/main/resources/application.yml).
# Spring Boot does NOT load .env files by itself: export these in your shell (or your IDE/run
# configuration, or a secret manager). Copy to `.env` only if your tooling loads it; `.env` is git-ignored.
# Every value here is a placeholder. Generate real secrets; never commit them.

# ---- Profile ---------------------------------------------------------------
# dev  = local development (dev-only defaults, OTP printed to the console, evaluator test phone enabled)
# prod = production (everything below is REQUIRED; no dev shortcuts)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---- MySQL -----------------------------------------------------------------
MYSQL_URL=jdbc:mysql://localhost:3307/takeoff?serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USER=takeoff
MYSQL_PASSWORD=change_me_db_password

# ---- RabbitMQ --------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=takeoff
RABBITMQ_PASSWORD=change_me_rabbit_password
# Optional overrides of the OTP topology (defaults shown)
OTP_EXCHANGE=takeoff.exchange
OTP_QUEUE=otp.queue
OTP_ROUTING_KEY=otp.routing.key
# Application-decision events (approve / reject) that trigger the driver's SMS
NOTIFICATION_QUEUE=notification.queue
NOTIFICATION_ROUTING_KEY=notification.routing.key

# ---- Document uploads --------------------------------------------------------
# Where uploaded driver documents are stored (the folder is git-ignored). Back it up and keep it out of the web root.
UPLOAD_DIR=./data/uploads
# Largest accepted document, in bytes (default 5 MB). The multipart transport limit in application.yml is slightly larger.
MAX_UPLOAD_BYTES=5242880

# ---- JWT -------------------------------------------------------------------
# REQUIRED outside the dev profile. At least 32 characters of random data, e.g.: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# ---- CORS ------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (the frontend URL).
FRONTEND_ORIGIN=http://localhost:5173

# ---- OTP -------------------------------------------------------------------
OTP_EXPIRATION_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Max codes issued per phone number per hour (real SMS costs money and can be abused).
OTP_MAX_SENDS_PER_HOUR=5
# REQUIRED outside dev/test: secret pepper used to hash OTPs before storing them.
OTP_PEPPER=

# ---- SMS (how the OTP reaches the user's phone) -----------------------------
# none   = nothing is sent (dev profile prints the code to the console; elsewhere codes are NOT delivered)
# twilio = send a real SMS to any E.164 number. Needs the three values below.
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender: a Twilio phone number OR a Messaging Service SID (the service wins if both are set).
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ---- First administrator (optional bootstrap) ------------------------------
# Public sign-up can never create admins. Set these once to create the first LOGISTICS_ADMIN,
# then remove them. The password must satisfy the same policy as drivers (15+ chars, uppercase, special).
ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_PHONE=
ADMIN_SEED_NAME=TakeOFF Administrator
