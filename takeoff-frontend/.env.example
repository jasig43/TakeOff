# Copy to `.env.local` for local development. Never commit real `.env` files.

# Base URL of the TakeOFF backend REST API (must match the backend port).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Set to "true" to show the evaluator hint (+15550199 -> OTP 123456) in non-dev builds.
# The hint is always shown under `npm run dev`. The backend only honours the fixed
# OTP when it runs with the dev or test profile.
VITE_SHOW_DEV_HINTS=false
